[Unit]
Description=Blora Panel Master
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=blora-master
Group=blora-master
WorkingDirectory=/opt/blora/master
ExecStart=/opt/blora/master/blora-master --state-dir /var/lib/blora/master --listen 127.0.0.1:8443 --static-dir /opt/blora/master/web/dist --extensions-dir /var/lib/blora/master/extensions
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=multi-user.target
